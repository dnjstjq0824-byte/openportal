{
  "name": "openportal-phase0",
  "version": "0.1.0",
  "description": "OpenPortal local verification tooling",
  "scripts": {
    "dev:gateway": "node --env-file=.env gateway/server.mjs",
    "provision:mail": "node --env-file=.env gateway/provision-mail.mjs",
