# LOCAL DEVELOPMENT ONLY
PORT=8080
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=documents_v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
CORS_ORIGIN=http://127.0.0.1:5173

# Persistent browser gateway; separate from the read-only Go search service.
DATABASE_URL=postgres://openportal:local_dev_password_change_me@127.0.0.1:5432/openportal
PUBLIC_ORIGIN=http://127.0.0.1:5173
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
SEARCH_BACKEND_URL=http://127.0.0.1:8080
RATE_LIMIT_SECRET=
# Same secret in the private gateway and Pages runtime (never a VITE_ variable).
GATEWAY_SHARED_SECRET=
# SMTP for account verification/reset (not a user mailbox service).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# JMAP mailbox service: configured server-side only; HTTPS required.
MAIL_JMAP_URL=
# 32 random bytes encoded in base64. Store in a secret manager; back it up securely.
MAIL_ENCRYPTION_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Operator provisioning only; do not place mailbox tokens in client build env.
MAILBOX_EMAIL=
MAILBOX_TOKEN=

# Search provider configuration:
# Supported values: 'opensearch' (default, uses SEARCH_BACKEND_URL) or 'brave' (Track A external API)
SEARCH_PROVIDER=opensearch
# Brave Search API integration (Track A)
# Required only when SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_API_TERMS_APPROVED=false
BRAVE_DAILY_REQUEST_LIMIT=1000
BRAVE_REQUESTS_PER_SECOND=1

# Optional candidate external providers (for Track A comparative testing)
BING_SEARCH_API_KEY=
BING_API_TERMS_APPROVED=false
