# LOCAL DEVELOPMENT & PRODUCTION TEMPLATE — OpenScanner
PORT=8080
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=documents_v2
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
CORS_ORIGIN=http://127.0.0.1:5173

# Distributed abuse burst counters (C-6). Unset → process-local memory
# counters (dev default). Compose prod sets redis://redis:6379.
REDIS_URL=

# Hybrid RRF over keyword + recall paths (C-6, default on).
# Set to 'false' to fall back to the single keyword path.
HYBRID_SEARCH_ENABLED=true

# Persistent browser gateway; separate from the read-only Go search service.
DATABASE_URL=postgres://openportal:local_dev_password_change_me@127.0.0.1:5432/openportal
PUBLIC_ORIGIN=http://127.0.0.1:5173
APP_BASE_URL=http://localhost:3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
SEARCH_BACKEND_URL=http://127.0.0.1:8080
RATE_LIMIT_SECRET=
# Same secret in the private gateway and Pages runtime (never a VITE_ variable).
GATEWAY_SHARED_SECRET=

# ==========================================
# OpenScanner SMTP Configuration (Plug-and-Play Dual-Mode)
# ==========================================
# "auto": SMTP_HOST 설정 시 실제 SMTP 발송, 미설정 시 로컬 프리뷰/폴백 자동 전환
# "smtp": 강제 실제 SMTP 발송
# "preview": 강제 로컬 프리뷰/콘솔 출력 모드
SMTP_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM_NAME=OpenScanner
SMTP_FROM_EMAIL=no-reply@openscanner.com
SMTP_FROM=
SMTP_REPLY_TO=support@openscanner.com
SMTP_POOL_ENABLED=true
SMTP_CONNECTION_TIMEOUT_MS=10000

# JMAP mailbox service: configured server-side only; HTTPS required.
MAIL_JMAP_URL=
# Hosted mailbox domain for username@domain signup. Leave empty outside production to use openscanner.test.
MAIL_DOMAIN=
# 32 random bytes encoded in base64. Store in a secret manager; back it up securely.
MAIL_ENCRYPTION_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
# Operator provisioning only; do not place mailbox tokens in client build env.
MAILBOX_EMAIL=
MAILBOX_TOKEN=

# Search provider configuration:
# Supported values: 'opensearch' (default), 'local', 'brave' (Track A external API) or 'hybrid' (local + Brave RRF).
# 'opensearch' and 'local' serve SEARCH_BACKEND_URL; 'hybrid' mixes it with Brave.
SEARCH_PROVIDER=opensearch
SEARCH_CORPUS_KIND=development
SEARCH_CORPUS_REVIEWED=false
# Crawling remains disabled until the operator sets an approved hostname list.
CRAWL_ALLOWED_HOSTS=
# Brave Search API integration (Track A)
# Required only when SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_API_TERMS_APPROVED=false
BRAVE_DAILY_REQUEST_LIMIT=1000
BRAVE_REQUESTS_PER_SECOND=1

# The public Bing Search API is retired. SEARCH_PROVIDER=bing is unsupported.

# Production compose stack (docker-compose.prod.yml, B-3).
# Host-port overrides for machines where defaults are taken:
API_HOST_PORT=8080
GATEWAY_HOST_PORT=8090
PG_HOST_PORT=5432
OS_HOST_PORT=9200
# Postgres credentials consumed by compose to assemble DATABASE_URL:
POSTGRES_USER=openportal
POSTGRES_PASSWORD=local_prod_password_change_me
POSTGRES_DB=openportal
# Fail-fast rules: gateway configuration() refuses to boot with NODE_ENV=production
# unless PUBLIC_ORIGIN is https + DATABASE_URL + RATE_LIMIT_SECRET +
# GATEWAY_SHARED_SECRET are set; the Go API refuses an invalid DATABASE_URL and
# reports unreachable dependencies via /readyz 503 with a cause.
